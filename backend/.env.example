# Standards-AI Backend Environment Configuration Example
# Copy this file to .env and customize values as appropriate.
# NEVER commit real API keys or secrets to source control.

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Configuration
# Set to your deployed frontend domain in production (e.g. https://standards-ai.vercel.app)
# Supports comma-separated list of origins or "*" for development
FRONTEND_ORIGIN=*

# Workspace Directory (Optional)
# In standard deployment, the system automatically resolves the data directory.
# WORKSPACE_DIR=/path/to/project_root

# Sarvam AI Translation Settings (Optional - Indian Language Translation)
# If omitted, English queries work 100% and Indic queries fall back cleanly to original text.
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate
SARVAM_REQUEST_TIMEOUT_SECONDS=10.0

# Requirement Extraction Settings (Document Ingestion)
# Set EXTRACTION_PROVIDER to "gemini" for production or "mock" for offline/test use
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_REQUIREMENT_MODEL=gemini-2.0-flash

# Qdrant Vector DB Settings (Optional)
# Defaults to embedded local storage at data/qdrant_storage
# QDRANT_URL=http://localhost:6333

# Embedding Model Settings (Local, 0 API keys)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
